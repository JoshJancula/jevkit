{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevkit.invalid/schema/redact-v1.json",
  "title": "jevkit redact.yaml, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "pattern": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "replacement": { "type": "string", "maxLength": 256 },
          "flags": { "type": "string", "pattern": "^[ims]{0,3}$" }
        }
      }
    },
    "literals": {
      "type": "array",
      "maxItems": 1024,
      "items": { "type": "string", "minLength": 4, "maxLength": 4096 }
    },
    "env_values": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_*?]{1,128}$" }
    },
    "allowlist": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string", "minLength": 1, "maxLength": 128 },
          "regex": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "literal": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "oneOf": [{ "required": ["regex"] }, { "required": ["literal"] }]
      }
    },
    "disable": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entropy_threshold": { "type": "number", "minimum": 2, "maximum": 6 },
        "min_token_length": { "type": "integer", "minimum": 16, "maximum": 256 },
        "path_handling": { "enum": ["rewrite", "keep"] }
      }
    },
    "never_send": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "mode": { "enum": ["standard", "strict"] },
    "review": { "type": "boolean" },
    "confirm": { "type": "boolean" },
    "review_max": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "review_ttl": { "type": "string", "minLength": 2, "maxLength": 16 },
    "tests": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input"],
        "properties": {
          "name": { "type": "string", "maxLength": 128 },
          "input": { "type": "string", "maxLength": 65536 },
          "must_not_contain": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
          "must_contain": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        }
      }
    },
    "placeholder": { "enum": ["label", "stable"] }
  }
}
