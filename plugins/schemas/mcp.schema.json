{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevkit.invalid/schema/plugin-mcp-v1.json",
  "title": "jevkit plugin MCP client config",
  "type": "object",
  "additionalProperties": false,
  "required": ["mcpServers"],
  "properties": {
    "mcpServers": {
      "type": "object",
      "required": ["jevkit"],
      "additionalProperties": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "const": "jevkit" },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
