{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "shared/jevkit-run.sh _runtime dispatch --protocol 1 cursor post-tool",
        "matcher": "Shell"
      },
      {
        "command": "shared/jevkit-run.sh _runtime dispatch --protocol 1 cursor post-tool",
        "matcher": "Read|read|readToolCall|Grep|grep|grepToolCall|Glob|glob|globToolCall|SemanticSearch|semanticSearch"
      },
      {
        "command": "shared/jevkit-run.sh _runtime dispatch --protocol 1 cursor post-tool",
        "matcher": "MCP:*"
      }
    ],
    "afterShellExecution": [
      {
        "command": "shared/jevkit-run.sh _runtime dispatch --protocol 1 cursor post-tool"
      }
    ]
  }
}
